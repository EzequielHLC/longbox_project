# Copiar a `.env` y completar. Sin este archivo el proyecto no arranca: las seis
# primeras variables no tienen valor por defecto a propósito, porque un default
# para una credencial es un default que termina en producción.
#
#   cp .env.example .env
#
# `.env` está en `.gitignore` y nunca se versiona.

# --- Obligatorias -----------------------------------------------------------

# Generar una distinta por instalación:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DB_NAME=longbox
DB_USER=longbox_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Despliegue -------------------------------------------------------------

# Solo con `config.settings.production`. Dominios separados por coma; sin esto
# Django rechaza todas las peticiones.
ALLOWED_HOSTS=

# --- Modelo de lenguaje (CU-04) ---------------------------------------------
#
# Estos valores son solo la **semilla** de la primera instalación: a partir de
# ahí el modelo se configura desde Parámetros globales y lo que manda es lo
# guardado en la base. Es a propósito — el sistema se demuestra desplegado y
# cambiar de proveedor no puede exigir reiniciar el servidor.

# Local (LM Studio) o remoto. Tiene que ser la ruta de chat, no la base.
LLM_URL=http://127.0.0.1:1234/v1/chat/completions

# Vacío usa el que el servidor tenga cargado. Los remotos exigen nombrarlo.
LLM_MODELO=

# La clave del proveedor remoto se carga desde la pantalla, no desde acá: en el
# archivo queda en texto plano y el `.env` se copia entre máquinas.
LLM_API_KEY=

# Un correo de 50 productos tarda unos dos minutos con el modelo local.
LLM_TIMEOUT=300

# 0 es lo más determinista. Para extraer datos no conviene subirla.
LLM_TEMPERATURA=0

# --- Negocio ----------------------------------------------------------------
#
# También son semilla: el valor vigente vive en `core.ConfiguracionSistema` y se
# administra desde Parámetros globales.

MARGEN_GANANCIA_GLOBAL=0.40
STOCK_INICIAL_POR_DEFECTO=1
